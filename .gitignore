/target
*.DS_Store

# Benchmark results (generated, large, machine-specific). We ignore each
# child rather than the directory itself because git cannot re-include
# files below a fully-excluded directory (see `gitignore(5)` — "It is not
# possible to re-include a file if a parent directory of that file is
# excluded.").
benchmarks/results/*
!benchmarks/results/criterion
benchmarks/results/criterion/*
# Criterion baseline JSON IS checked in (issue #54): it's small,
# hand-curated, and the trend-tracking signal lives in version control
# rather than CI cache.
!benchmarks/results/criterion/baseline.json

# Generated benchmark artifacts
benchmarks/results/**/*.svg

# Docs (VitePress)
docs/node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/

# Local workspace files
TODO.md

# Local config (copy zion.example.toml and customize)
zion.toml
GEMINI_IMPRO.md

# Build outputs (release tarballs at repo root only — the leading `/`
# anchors the `zion-*` glob to the repo root so it doesn't match nested
# crates or source dirs).
/zion-*
*.tar.gz

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
benchmarks/backend/target/
benchmarks/backend/Cargo.lock

# Sovereign Edge — local review files (authoritative data is in src/sovereign/)
sovereign-*-ranges.txt
.sovereign-data/

# Claude Code local workspace state (per-developer, not for public repo)
.claude/

# Internal design notes / working drafts (private until publicly released)
docs/internal/

# Editor backups and swap files
*.bak
*.swp
*~

# Benchmark TLS material — generate on demand via benchmarks/certs/generate.sh
benchmarks/certs/*.key
benchmarks/certs/*.crt
benchmarks/certs/*.pem


