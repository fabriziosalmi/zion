#!/usr/bin/env bash

# ============================================================================
# ZION POST-COMMIT HOOK (optional benchmark)
# Set ZION_BENCH=1 to run smoke benchmark after each commit.
# Results are tracked in benchmarks/bench-history.json
# ============================================================================

if [[ "${ZION_BENCH:-0}" == "1" ]]; then
    echo ""
    echo "── zion post-commit benchmark ──"
    bash benchmarks/bench-smoke.sh
    echo "── benchmark complete ──"
fi
